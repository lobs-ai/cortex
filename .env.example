# Backend
PORT=9009
JWT_SECRET=change-me-in-prod
ENCRYPTION_KEY=change-me-32-bytes-base64-encoded
CORTEX_ENV=dev
CORS_ORIGINS=http://localhost:3030,http://localhost:3000

# LLM (optional — stubs return canned responses when unset)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Google Calendar OAuth (see docs/INTEGRATIONS.md for step-by-step setup).
# When empty, the "Connect Google Calendar" button returns a helpful error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9009/api/integrations/google/callback

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_USER_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:9009
